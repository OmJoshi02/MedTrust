# -----------------------------------------------------------------------------
# MedTrust frontend configuration
# Copy this file to ".env" and edit the values. Vite only exposes variables
# that start with VITE_. Never put secrets or API credentials in this file.
# -----------------------------------------------------------------------------

# Base URL of the MedTrust backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Path prefix shared by all backend endpoints.
VITE_API_PREFIX=/api/v1

# true  = run entirely on isolated, clearly labelled SAMPLE data. No backend is
#         needed. Authentication in this mode is NOT real or secure.
# false = use the backend configured above. Failed requests show real errors;
#         sample data is never substituted.
VITE_DEMO_MODE=true

# Timeout for ordinary API requests, in milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Timeout for an upload + analysis request, in milliseconds.
VITE_ANALYSIS_TIMEOUT_MS=120000

# Maximum accepted image size, in megabytes.
VITE_MAX_UPLOAD_MB=15

# Show a "Remember me" option on the login form. Enable only if your backend
# honours a remember_me flag when issuing its session cookie.
VITE_ENABLE_REMEMBER_ME=false

# Optional project details shown on the About page.
VITE_INSTITUTION=
VITE_CONTACT_EMAIL=
# JSON array, e.g. [{"name":"Full Name","role":"Role"}]
VITE_PROJECT_TEAM=

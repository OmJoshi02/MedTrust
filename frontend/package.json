  "version": "1.0.0",
  "description": "MedTrust: trust-aware, explainable chest X-ray analysis. Frontend research application.",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",

# ==============================================================================
# MedTrust V1 — Production Deployment Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment environment.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
MEDTRUST_ENV=production

# Cross-Origin Resource Sharing (CORS) Allowlist
# Provide comma-separated list of authorized frontend domains/origins.
# Never set to '*' in production environments.
MEDTRUST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Security & Cookie Settings
# Set to 1 when serving over TLS/HTTPS (enforces 'Secure' attribute on session cookies)
MEDTRUST_SECURE_COOKIES=0

# Upload Payload Limits (in bytes)
# Default is 15MB (15 * 1024 * 1024 = 15728640)
MEDTRUST_MAX_UPLOAD_BYTES=15728640

# Computational Hardware Inference Device
# Set to 'cuda' to utilize NVIDIA GPU, or 'cpu' for fallback compute
MEDTRUST_DEVICE=cuda

# Database Path Configuration
# Path relative to repository root or absolute path
MEDTRUST_DB_PATH=backend/medtrust.db

# Development Seeding
# In production, keep set to 0. Use 'python backend/manage.py create-admin' to provision operators.
SEED_DEV_INVESTIGATOR=0

